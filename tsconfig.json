{
  "compilerOptions": {
    "rootDirs": ["./src"],
    "outDir": "./dist",

    "module": "nodenext",
    "moduleResolution": "nodenext",

    "target": "esnext",
    "lib": ["esnext"],
    "types": ["node", "express", "multer"],

    "sourceMap": true,

    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  }
}